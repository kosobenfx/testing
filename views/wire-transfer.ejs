<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Manufacturers, Suppliers, Exporters & Importers from the world's largest online B2B marketplace-Alibaba.com</title>
<link rel="shortcut icon" href="//is.alicdn.com/favicon.ico" type="image/x-icon" />
  <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
      font-size: 14px;
      color: #333;
      background: #f0f0f0;
      min-height: 100vh;
    }

    /* ── HEADER ── */
    .site-header {
      background: #fff;
      border-bottom: 1px solid #e8e8e8;
      padding: 0 32px;
      height: 56px;
      display: flex;
      align-items: center;
    }
    .site-logo {
      font-size: 22px;
      font-weight: 700;
      color: #e55a00;
      text-decoration: none;
      letter-spacing: -0.5px;
    }
    .site-logo span { color: #333; }

    /* ── TOP BAR ── */
    .top-bar {
      background: #f0f0f0;
      padding: 20px 32px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      max-width: 1200px;
      margin: 0 auto;
    }
    .back-link {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 14px;
      color: #333;
      text-decoration: none;
      cursor: pointer;
    }
    .back-link:hover { opacity: 0.75; }
    .back-link svg { flex-shrink: 0; }

    .top-actions {
      display: flex;
      align-items: center;
      gap: 12px;
    }
    .btn-save-img {
      padding: 9px 22px;
      border: 1.5px solid #333;
      border-radius: 24px;
      background: #fff;
      font-size: 14px;
      font-weight: 500;
      color: #333;
      cursor: pointer;
      transition: background 0.15s;
    }
    .btn-save-img:hover { background: #f5f5f5; }

    .btn-print {
      width: 40px;
      height: 40px;
      border: 1.5px solid #333;
      border-radius: 50%;
      background: #fff;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      transition: background 0.15s;
    }
    .btn-print:hover { background: #f5f5f5; }

    /* ── CARD ── */
    .page-wrap {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 32px 60px;
    }

    .card {
      background: #fff;
      border-radius: 12px;
      padding: 40px 48px;
    }

    /* ── CARD HEADER ── */
    .card-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      margin-bottom: 32px;
    }
    .card-title {
      font-size: 26px;
      font-weight: 700;
      color: #111;
    }
    .order-no {
      font-size: 14px;
      color: #888;
    }
    .order-no a {
      color: #555;
      text-decoration: underline;
      cursor: pointer;
    }

    /* ── AMOUNT BOX ── */
    .amount-box {
      border: 1px solid #e0e0e0;
      border-radius: 8px;
      padding: 28px 32px 24px;
      margin-bottom: 28px;
      text-align: left;
    }
    .amount-box .big-amount {
      text-align: center;
      font-size: 32px;
      font-weight: 700;
      color: #111;
      margin-bottom: 24px;
      letter-spacing: -0.5px;
    }
    .amount-info-row {
      display: grid;
      grid-template-columns: 220px 1fr;
      gap: 10px;
      margin-bottom: 14px;
      font-size: 14px;
    }
    .amount-info-row:last-child { margin-bottom: 0; }
    .amount-info-label {
      color: #555;
      line-height: 1.5;
    }
    .amount-info-value {
      font-weight: 600;
      color: #111;
    }

    /* ── DETAILS TABLE ── */
    .details-table {
      width: 100%;
      border-collapse: collapse;
      margin-bottom: 36px;
    }
    .details-table tr {
      border-bottom: 1px solid #ebebeb;
    }
    .details-table tr:first-child {
      border-top: 1px solid #ebebeb;
    }
    .details-table td {
      padding: 16px 20px;
      font-size: 14px;
      vertical-align: top;
    }
    .details-table td:first-child {
      width: 48%;
      color: #555;
      font-weight: 400;
    }
    .details-table td:last-child {
      color: #111;
      font-weight: 600;
    }

    /* Citibank logo inline */
    .citibank-logo {
      display: inline-flex;
      align-items: center;
      margin-left: 10px;
      font-size: 16px;
      font-weight: 700;
      letter-spacing: -0.3px;
    }
    .citibank-logo .citi-arc {
      color: #003b70;
    }
    .citibank-logo .citi-bank {
      color: #003b70;
    }
    .citibank-logo .citi-dot {
      display: inline-block;
      width: 10px;
      height: 10px;
      border-radius: 50%;
      background: #e55a00;
      margin: 0 1px 0 0;
      vertical-align: middle;
      position: relative;
      top: -1px;
    }

    .remark-order {
      font-size: 14px;
      font-weight: 600;
      color: #111;
      display: block;
      margin-bottom: 4px;
    }
    .remark-note {
      font-size: 13px;
      color: #666;
      font-weight: 400;
    }

    /* ── NOTICE ── */
    .notice-section {
      margin-top: 8px;
    }
    .notice-title {
      font-size: 16px;
      font-weight: 700;
      color: #111;
      margin-bottom: 14px;
    }
    .notice-list {
      list-style: disc;
      padding-left: 20px;
    }
    .notice-list li {
      font-size: 14px;
      color: #444;
      line-height: 1.7;
      margin-bottom: 0;
    }

    /* ── SUPPORT BUTTON ── */
    .support-btn {
      position: fixed;
      right: 0;
      top: 50%;
      transform: translateY(-50%);
      width: 40px;
      height: 40px;
      background: #4a90d9;
      border-radius: 50% 0 0 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      z-index: 100;
    }

    /* ── PRINT STYLES ── */
    @media print {
      body { background: #fff; }
      .site-header, .top-bar, .support-btn { display: none !important; }
      .page-wrap { padding: 20px; }
      .card { box-shadow: none; border: none; padding: 0; }
    }
    .logo {
      float: inline-start;
      margin-top: 9px;
      margin-inline-start: 5px;
      width: 210px;
      height: 38px;
      background-image: url(data:image/svg+xml;base64,);
      background-size: auto 20px;
      background-repeat: no-repeat;
      background-position: center;
      font-size: 0;
    }

    .checkout-payment-icon-medium {
      height: 20px;
    }
  </style>
</head>
<body>

  <!-- HEADER -->
  <header class="site-header">
    <a class="logo" href="#"></a>
  </header>

  <!-- TOP BAR -->
  <div class="top-bar">
    <a class="back-link" href="javascript:history.back()">
      <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path d="M15 18l-6-6 6-6"/>
      </svg>
      Wire transfer account information
    </a>
    <div class="top-actions">
      <button class="btn-save-img" onclick="saveAsImage()">Save as image</button>
      <button class="btn-print" onclick="window.print()" title="Print">
        <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
          <polyline points="6 9 6 2 18 2 18 9"/>
          <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/>
          <rect x="6" y="14" width="12" height="8"/>
        </svg>
      </button>
    </div>
  </div>

  <!-- MAIN CARD -->
  <div class="page-wrap">
    <div class="card" id="transfer-card">

      <!-- Card Header -->
      <div class="card-header">
        <h1 class="card-title">International transfer</h1>
        <div class="order-no">Order No. <a href="#">#<%= order_id %></a></div>
      </div>

      <!-- Amount Box -->
      <div class="amount-box">
        <div class="big-amount"><%= currency %> <%= Number(amount + shipping_fee + process_fee).toLocaleString('en-US', { minimumFractionDigits: 2 }) %></div>
        <div class="amount-info-row">
          <span class="amount-info-label">Payment processing fee<br>charged by your bank:</span>
          <span class="amount-info-value"><%= currency %> <%= process_fee %> (estimated)</span>
        </div>
        <div class="amount-info-row">
          <span class="amount-info-label">Processing time:</span>
          <span class="amount-info-value">3 - 7 business days</span>
        </div>
        <div class="amount-info-row">
          <span class="amount-info-label">Payment currency:</span>
          <span class="amount-info-value"><%= currency %></span>
        </div>
      </div>

      <!-- Details Table -->
      <table class="details-table">
        <tbody>
          <tr>
            <td>Payment currency:</td>
            <td><%= payment_currency %></td>
          </tr>
          <tr>
            <td>Beneficiary account number:</td>
            <td><%= beneficiary_account_number %></td>
          </tr>
          <tr>
            <td>SWIFT code:</td>
            <td><%= swift_code %></td>
          </tr>
          <tr>
            <td>Beneficiary country/region:</td>
            <td><%= beneficiary_country_region %></td>
          </tr>
          <tr>
            <td>Beneficiary name:</td>
            <td><%= beneficiary_name %></td>
          </tr>
          <tr>
            <td>Beneficiary address:</td>
            <td><%= beneficiary_address %></td>
          </tr>
          <tr>
            <td>Beneficiary bank:</td>
            <td>
              <%= beneficiary_bank %>
              <!-- Citibank styled logo -->
              <img 
                data-i18n-appname="" 
                data-i18n-ns="" 
                data-i18n-key="checkout.payment-icon.citibank" 
                src="https://s.alicdn.com/@img/tfs/TB1UtDLNSzqK1RjSZPxXXc4tVXa-137-40.svg" 
                class="checkout-payment-icon-medium logo-citi"
              >
            </td>
          </tr>
          <tr>
            <td>Beneficiary bank address:</td>
            <td><%= beneficiary_bank_address %></td>
          </tr>
          <tr>
            <td>Bank code:</td>
            <td><%= bank_code %></td>
          </tr>
          <tr>
            <td>Branch code:</td>
            <td><%= branch_code %></td>
          </tr>
          <tr>
            <td>Remark:</td>
            <td>
              <span class="remark-order"><%= remark %></span>
              <span class="remark-note">*Please attach this order number</span>
            </td>
          </tr>
        </tbody>
      </table>

      <!-- Notice -->
      <div class="notice-section">
        <div class="notice-title">Notice</div>
        <ul class="notice-list">
          <li>
            You will ONLY be covered by Trade Assurance when you make a payment to this supplier's account shown above.
            Please pay attention to fill in the correct Beneficiary Account Number, as the beneficiary bank will review the beneficiary account number to receive the payment.<br>
            The details of telegraphic transfer, including but not limited to beneficiary name, account number, address, SWIFT code and processing time shown on this page are furnished by Citibank National Association ("Bank"), which are subject to change by the Bank at any time.
          </li>
        </ul>
      </div>

    </div><!-- /card -->
  </div><!-- /page-wrap -->

  <!-- Support button -->
  <div class="support-btn">
    <svg width="20" height="20" fill="#fff" viewBox="0 0 24 24">
      <path d="M12 2a10 10 0 1 0 10 10A10 10 0 0 0 12 2zm0 18a8 8 0 1 1 8-8 8 8 0 0 1-8 8zm-1-5h2v2h-2zm0-8h2v6h-2z"/>
    </svg>
  </div>

  <script>
    async function saveAsImage() {
      const card = document.getElementById('transfer-card');
      const btn  = document.querySelector('.btn-save-img');

      btn.textContent = 'Saving…';
      btn.disabled = true;

      try {
        const canvas = await html2canvas(card, {
          scale: 2,
          useCORS: true,
          backgroundColor: '#ffffff',
          logging: false
        });

        const link = document.createElement('a');
        link.download = 'wire-transfer-<%= order_id %>.png';
        link.href = canvas.toDataURL('image/png');
        link.click();
      } catch (err) {
        console.error('Save as image failed:', err);
        alert('Could not save image. Please try the print/screenshot option.');
      } finally {
        btn.textContent = 'Save as image';
        btn.disabled = false;
      }
    }
  </script>

</body>
</html>
