    </div>

</div>
  <script>

    const modifyOrderModal =
        document.getElementById('modifyOrderModal');
    
    const cancelOrderModal =
        document.getElementById('cancelOrderModal');
    
    const requestModificationBtn =
        document.getElementById('requestModificationBtn');
    
    const cancelOrderBtn =
        document.getElementById('cancelOrderBtn');
    
    requestModificationBtn.addEventListener('click', () => {
        modifyOrderModal.classList.add('active');
    });
    
    cancelOrderBtn.addEventListener('click', () => {
        cancelOrderModal.classList.add('active');
    });
    
    document.querySelectorAll('[data-close]')
        .forEach(btn => {
    
            btn.addEventListener('click', () => {
    
                const target =
                    document.getElementById(
                        btn.dataset.close
                    );
    
                target.classList.remove('active');
    
            });
    
        });
    
    [modifyOrderModal, cancelOrderModal]
        .forEach(modal => {
    
            modal.addEventListener('click', (e) => {
    
                if (e.target === modal) {
                    modal.classList.remove('active');
                }
    
            });
    
        });
    
    const textarea =
        document.querySelector('.modal-textarea');
    
    const counter =
        document.querySelector('.modal-counter');
    
    if (textarea && counter) {
    
        textarea.addEventListener('input', () => {
    
            counter.textContent =
                `${textarea.value.length}/500`;
    
        });
    
    }
    
    </script>
