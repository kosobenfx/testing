        <p class="modal-subtitle">
            Tell us why you would like to cancel
        </p>

        <form
            action="#"
            method="POST">

            <div class="cancel-options">

                <label class="radio-option">
                    <input
                        type="radio"
                        name="cancel_reason"
                        value="Shipping fee increased">
                    Shipping fee increased
                </label>

                <label class="radio-option">
                    <input
                        type="radio"
                        name="cancel_reason"
                        value="No stock">
